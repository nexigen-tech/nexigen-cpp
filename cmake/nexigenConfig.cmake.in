@PACKAGE_INIT@

# nexigen-cpp package configuration.
#
# The exported targets reference Threads::Threads (link-only, from the static
# archives) and nlohmann_json::nlohmann_json (INTERFACE, from nexigen::core).
# Resolve them here so consumers only need find_package(nexigen CONFIG).

include(CMakeFindDependencyMacro)

find_dependency(Threads)
# Mandate 12 (openspec/config.yaml): only nlohmann/json exactly v3.12.0 —
# an installed package of any other version does not satisfy the dependency
# (unlike the build tree, the installed config has no FetchContent fallback).
find_dependency(nlohmann_json 3.12.0 EXACT)

include("${CMAKE_CURRENT_LIST_DIR}/nexigenTargets.cmake")

# The exported nexigen::core hides nlohmann_json behind BUILD_INTERFACE so the
# package can be generated from a FetchContent build too. Re-attach the
# dependency here, after find_dependency has defined its imported target.
set_property(TARGET nexigen::core APPEND PROPERTY
    INTERFACE_LINK_LIBRARIES nlohmann_json::nlohmann_json)

check_required_components(nexigen)
