---
# Cold-path maintainability checks. Hot-path invariants are already enforced by
# the compiler flags and the RT-specific review rules; this profile focuses on
# bug-prone constructs and accidental copies in control-plane code.
#
# Intentionally disabled:
#   bugprone-easily-swappable-parameters: string_view APIs (request/name,
#     query/key) are documented at the call site and the check is pure noise.
#   bugprone-unused-return-value: the project idiom for best-effort cold-path
#     results is `static_cast<void>(status)`; the check does not honour it.
#     Dangerous Result access is covered by cmake/check_result_value.py.
#   bugprone-signed-char-misuse, bugprone-branch-clone,
#   bugprone-tagged-union-member-count: intentional ASCII parsing and compact
#     tagged layouts; the checks are not actionable here.
#   performance-unnecessary-value-param: std::stop_token and string_view are
#     cheap by-value types in this codebase.
#   clang-analyzer-optin.*: opt-in analyzers flag intentional hot-path padding
#     in aligned real-time classes.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-unused-return-value,
  -bugprone-signed-char-misuse,
  -bugprone-branch-clone,
  -bugprone-tagged-union-member-count,
  performance-*,
  -performance-unnecessary-value-param,
  portability-*,
  -portability-avoid-pragma-once,
  clang-analyzer-*,
  -clang-analyzer-optin.*
WarningsAsErrors: '*'
HeaderFilterRegex: '.*/(include|src)/.*'
FormatStyle: none
